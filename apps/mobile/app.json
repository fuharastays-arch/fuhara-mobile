{
  "expo": {
    "name": "Fuhara Stays",
    "slug": "fuhara-mobile",
    "version": "0.7.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fuhara",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuhara.mobile.staging",
      "icon": "./assets/expo.icon",
      "associatedDomains": [
        "applinks:fuhara-product-staging.vercel.app"
      ]
    },
    "android": {
      "package": "com.fuhara.mobile.staging",
      "versionCode": 75,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B2927",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "fuhara-product-staging.vercel.app",
              "pathPrefix": "/properties"
            },
            {
              "scheme": "https",
              "host": "fuhara-product-staging.vercel.app",
              "pathPrefix": "/account/bookings"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-windows-cmake-short-path.cjs",
      "./plugins/with-internal-beta-signing.cjs",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fuhara to add property photos from your library.",
          "cameraPermission": "Allow Fuhara to take property photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0EA39A",
          "defaultChannel": "bookings"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2927",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "environment": "staging",
      "supabaseProjectRef": "xhneambzjwqqwhtcnytq",
      "paymentsEnabled": false,
      "payoutExecutionEnabled": false,
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
