{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      }
    },
    "play-internal": {
      "distribution": "store",
      "environment": "preview",
      "channel": "staging",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
