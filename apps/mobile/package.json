{
  "name": "@fuhara/mobile",
  "version": "0.7.5",
  "main": "expo-router/entry",
  "dependencies": {
    "@fuhara/core": "0.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint-compat": "npm:typescript@5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "node -r ./scripts/pin-eslint-typescript.cjs ../../node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "npx expo-doctor",
    "export": "expo export --platform android --output-dir dist/android"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/test/lucide-react-native.cjs"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
